{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary":            "#{{colors.primary.default.hex_stripped}}",
    "secondary":          "#{{colors.secondary.default.hex_stripped}}",
    "accent":             "#{{colors.tertiary.default.hex_stripped}}",
    "error":              "#{{colors.error.default.hex_stripped}}",
    "warning":            "#{{colors.tertiary.default.hex_stripped}}",
    "success":            "#{{colors.secondary.default.hex_stripped}}",
    "info":               "#{{colors.primary.default.hex_stripped}}",

    "text":               "#{{colors.on_background.default.hex_stripped}}",
    "textMuted":          "#{{colors.on_surface_variant.default.hex_stripped}}",

    "background":         "#{{colors.background.default.hex_stripped}}",
    "backgroundPanel":    "#{{colors.surface.default.hex_stripped}}",
    "backgroundElement":  "#{{colors.surface_variant.default.hex_stripped}}",

    "border":             "#{{colors.outline_variant.default.hex_stripped}}",
    "borderActive":       "#{{colors.primary.default.hex_stripped}}",
    "borderSubtle":       "#{{colors.surface_variant.default.hex_stripped}}",

    "diffAdded":          "#{{colors.secondary.default.hex_stripped}}",
    "diffRemoved":        "#{{colors.error.default.hex_stripped}}",
    "diffContext":        "#{{colors.on_surface_variant.default.hex_stripped}}",
    "diffHunkHeader":     "#{{colors.on_surface_variant.default.hex_stripped}}",
    "diffHighlightAdded": "#{{colors.secondary.default.hex_stripped}}",
    "diffHighlightRemoved": "#{{colors.error.default.hex_stripped}}",
    "diffAddedBg":        "#{{colors.secondary_container.default.hex_stripped}}",
    "diffRemovedBg":      "#{{colors.error_container.default.hex_stripped}}",
    "diffContextBg":      "#{{colors.surface.default.hex_stripped}}",
    "diffLineNumber":     "#{{colors.on_surface_variant.default.hex_stripped}}",
    "diffAddedLineNumberBg":   "#{{colors.secondary_container.default.hex_stripped}}",
    "diffRemovedLineNumberBg": "#{{colors.error_container.default.hex_stripped}}",

    "markdownText":           "#{{colors.on_background.default.hex_stripped}}",
    "markdownHeading":        "#{{colors.primary.default.hex_stripped}}",
    "markdownLink":           "#{{colors.tertiary.default.hex_stripped}}",
    "markdownLinkText":       "#{{colors.on_primary_container.default.hex_stripped}}",
    "markdownCode":           "#{{colors.secondary.default.hex_stripped}}",
    "markdownBlockQuote":     "#{{colors.on_surface_variant.default.hex_stripped}}",
    "markdownEmph":           "#{{colors.tertiary.default.hex_stripped}}",
    "markdownStrong":         "#{{colors.primary.default.hex_stripped}}",
    "markdownHorizontalRule": "#{{colors.outline_variant.default.hex_stripped}}",
    "markdownListItem":       "#{{colors.on_background.default.hex_stripped}}",
    "markdownListEnumeration":"#{{colors.primary.default.hex_stripped}}",
    "markdownImage":          "#{{colors.tertiary.default.hex_stripped}}",
    "markdownImageText":      "#{{colors.on_primary_container.default.hex_stripped}}",
    "markdownCodeBlock":      "#{{colors.on_background.default.hex_stripped}}",

    "syntaxComment":      "#{{colors.on_surface_variant.default.hex_stripped}}",
    "syntaxKeyword":      "#{{colors.primary.default.hex_stripped}}",
    "syntaxFunction":     "#{{colors.secondary.default.hex_stripped}}",
    "syntaxVariable":     "#{{colors.on_background.default.hex_stripped}}",
    "syntaxString":       "#{{colors.tertiary.default.hex_stripped}}",
    "syntaxNumber":       "#{{colors.on_secondary_container.default.hex_stripped}}",
    "syntaxType":         "#{{colors.secondary.default.hex_stripped}}",
    "syntaxOperator":     "#{{colors.primary.default.hex_stripped}}",
    "syntaxPunctuation":  "#{{colors.on_surface_variant.default.hex_stripped}}"
  }
}
