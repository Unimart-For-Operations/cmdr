# starship.toml — generated by matugen on every wallpaper change
# Template source: home/modules/shell/starship-colors.toml.tera
# DO NOT EDIT — this file is overwritten by DankMaterialShell / matugen.
#
# Segment → Material You color mapping:
#   username  : secondary        (pill 1)
#   directory : tertiary         (pill 2)
#   git/tf    : primary_container (pill 3)
#   languages : secondary_container (pill 4)
#   docker    : surface_variant  (pill 5)
#   time      : primary          (pill 6)
#   base text : on_* counterparts for each pill

"$schema" = "https://starship.rs/config-schema.json"

format = "[](#{{ colors.secondary.default.hex_stripped }})$os$username[](bg:#{{ colors.tertiary.default.hex_stripped }} fg:#{{ colors.secondary.default.hex_stripped }})$directory[](fg:#{{ colors.tertiary.default.hex_stripped }} bg:#{{ colors.primary_container.default.hex_stripped }})$git_branch$git_status$terraform[](fg:#{{ colors.primary_container.default.hex_stripped }} bg:#{{ colors.secondary_container.default.hex_stripped }})$c$elixir$elm$golang$gradle$haskell$java$julia$nodejs$nim$rust$scala[](fg:#{{ colors.secondary_container.default.hex_stripped }} bg:#{{ colors.surface_variant.default.hex_stripped }})$docker_context[](fg:#{{ colors.surface_variant.default.hex_stripped }} bg:#{{ colors.primary.default.hex_stripped }})$time[ ](fg:#{{ colors.primary.default.hex_stripped }})"

[username]
show_always = true
style_user  = "bg:#{{ colors.secondary.default.hex_stripped }} fg:#{{ colors.on_secondary.default.hex_stripped }}"
style_root  = "bg:#{{ colors.secondary.default.hex_stripped }} fg:#{{ colors.on_secondary.default.hex_stripped }}"
format      = "[$user ]($style)"
disabled    = false

[os]
style    = "bg:#{{ colors.secondary.default.hex_stripped }} fg:#{{ colors.on_secondary.default.hex_stripped }}"
disabled = true

[directory]
style             = "bg:#{{ colors.tertiary.default.hex_stripped }} fg:#{{ colors.on_tertiary.default.hex_stripped }}"
format            = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music"     = " "
"Pictures"  = " "

[git_branch]
symbol = ""
style  = "bg:#{{ colors.primary_container.default.hex_stripped }} fg:#{{ colors.on_primary_container.default.hex_stripped }}"
format = "[ $symbol $branch ]($style)"

[git_status]
style  = "bg:#{{ colors.primary_container.default.hex_stripped }} fg:#{{ colors.on_primary_container.default.hex_stripped }}"
format = "[$all_status$ahead_behind ]($style)"

[terraform]
symbol             = "󱁢 "
style              = "bg:#{{ colors.primary_container.default.hex_stripped }} fg:#{{ colors.on_primary_container.default.hex_stripped }}"
format             = "[ $symbol $workspace ]($style)"
detect_extensions  = ["tf", "tfvars"]
detect_files       = ["terraform.tfstate"]
detect_folders     = [".terraform"]

[c]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[cpp]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[elixir]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[elm]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[golang]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[gradle]
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[haskell]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[java]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[julia]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[nodejs]
symbol = ""
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[nim]
symbol = "󰆥 "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[rust]
symbol = ""
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[scala]
symbol = " "
style  = "bg:#{{ colors.secondary_container.default.hex_stripped }} fg:#{{ colors.on_secondary_container.default.hex_stripped }}"
format = "[ $symbol ($version) ]($style)"

[docker_context]
symbol = " "
style  = "bg:#{{ colors.surface_variant.default.hex_stripped }} fg:#{{ colors.on_surface_variant.default.hex_stripped }}"
format = "[ $symbol $context ]($style)"

[time]
disabled    = false
time_format = "%R"
style       = "bg:#{{ colors.primary.default.hex_stripped }} fg:#{{ colors.on_primary.default.hex_stripped }}"
format      = "[ ♥ $time ]($style)"
